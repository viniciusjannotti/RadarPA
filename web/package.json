{
  "name": "radarpa-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && tsx scripts/gerar-sw.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:start": "tsx scripts/db-dev.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "test": "tsx scripts/with-test-db.ts -- vitest run",
    "test:unit": "vitest run --project unit",
    "test:py": "tsx scripts/with-test-db.ts --cwd ../collectors -- python-venv -m pytest -q",
    "collect": "cd ../collectors && python run_all.py",
    "icones": "tsx scripts/gerar-icones.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.6",
    "jose": "^6.2.12",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "prisma": "^7.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "mysql2": "^3.23.1",
    "deepmerge-ts": "^8.0.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
