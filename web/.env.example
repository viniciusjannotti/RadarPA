# Postgres. Em dev: npm run db:start (Postgres embutido na porta 54329).
# Na Vercel ela vem da integração do Neon (o app prefere DATABASE_URL_UNPOOLED, a conexão
# direta; ver src/lib/database-url.ts). NÃO use estas credenciais em produção.
DATABASE_URL="postgresql://radarpa:radarpa@127.0.0.1:54329/radarpa"

# Senha única de acesso ao app (usuário único). Mínimo 12 caracteres.
# Trocar a senha derruba todas as sessões abertas.
ADMIN_PASSWORD=""

# Chave para assinar o JWT de sessão (mínimo 32 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# Opcional: análise com IA no perfil do vereador (Google Gemini, tem cota gratuita).
# Gere a chave em https://aistudio.google.com/apikey. Sem ela a seção de IA some.
GEMINI_API_KEY=""
# Opcional: troca o modelo sem mexer no código (padrão: gemini-3.5-flash).
GEMINI_MODEL=""
