# Postgres. Em dev: npm run db:start (Postgres embutido na porta 54329).
# No Railway a variável é injetada automaticamente — NÃO use estas credenciais em produção.
DATABASE_URL="postgresql://radarpa:radarpa@127.0.0.1:54329/radarpa"

# Senha única de acesso ao app (usuário único). Mínimo 8 caracteres.
ADMIN_PASSWORD=""

# Chave para assinar o JWT de sessão (mínimo 32 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# URL pública do app (usada no manifest/links absolutos).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
